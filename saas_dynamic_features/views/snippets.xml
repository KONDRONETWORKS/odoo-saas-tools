<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Dynamic Hero Snippet -->
    <template id="s_dynamic_hero" name="Dynamic Hero">
        <section class="s_dynamic_hero pt120 pb120 bg-primary position-relative overflow-hidden" data-vcss="001" data-snippet="s_dynamic_hero">
            <div class="s_dynamic_hero_bg position-absolute w-100 h-100" style="top:0; left:0; z-index:0;"></div>
            <div class="container position-relative" style="z-index:1;">
                <div class="row align-items-center">
                    <div class="col-lg-6 text-white">
                        <h1 class="display-3 font-weight-bold mb-4 animate__animated animate__fadeInLeft">Launch Your SaaS</h1>
                        <p class="lead mb-5 animate__animated animate__fadeInLeft animate__delay-1s">Build, scale, and manage your business with our all-in-one platform.</p>
                        <div class="animate__animated animate__fadeInUp animate__delay-2s">
                            <a href="#" class="btn btn-light btn-lg rounded-pill px-5 me-3">Get Started</a>
                            <a href="#" class="btn btn-outline-light btn-lg rounded-pill px-5">Learn More</a>
                        </div>
                    </div>
                    <div class="col-lg-6">
                        <div class="s_dynamic_hero_img animate__animated animate__fadeInRight">
                            <img src="/web/static/img/logo.png" class="img-fluid" alt="SaaS Platform"/>
                        </div>
                    </div>
                </div>
            </div>
        </section>
    </template>

    <!-- 3D Features Snippet -->
    <template id="s_3d_features" name="3D Features">
        <section class="s_3d_features pt80 pb80 bg-white" data-vcss="001" data-snippet="s_3d_features">
            <div class="container">
                <div class="row text-center mb-5">
                    <div class="col-12">
                        <h2 class="display-4">Why Choose Us?</h2>
                        <p class="text-muted">Experience the difference with our cutting-edge technology.</p>
                    </div>
                </div>
                <div class="row g-4">
                    <div class="col-md-4">
                        <div class="s_3d_card p-4 rounded shadow-sm h-100 text-center bg-light">
                            <div class="s_3d_icon mb-3 text-primary display-4">
                                <i class="fa fa-rocket"/>
                            </div>
                            <h3>Fast Performance</h3>
                            <p>Optimized for speed and reliability.</p>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="s_3d_card p-4 rounded shadow-sm h-100 text-center bg-light">
                            <div class="s_3d_icon mb-3 text-success display-4">
                                <i class="fa fa-shield"/>
                            </div>
                            <h3>Secure by Design</h3>
                            <p>Enterprise-grade security for your data.</p>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="s_3d_card p-4 rounded shadow-sm h-100 text-center bg-light">
                            <div class="s_3d_icon mb-3 text-info display-4">
                                <i class="fa fa-cogs"/>
                            </div>
                            <h3>Fully Customizable</h3>
                            <p>Tailor the platform to your needs.</p>
                        </div>
                    </div>
                </div>
            </div>
        </section>
    </template>

    <!-- Register Snippets -->
    <template id="snippets" inherit_id="website.snippets">
        <xpath expr="//div[@id='snippet_structure']/div[@class='o_panel_body']" position="inside">
            <t t-snippet="saas_dynamic_features.s_dynamic_hero" t-thumbnail="/website/static/src/img/snippets_thumbs/s_banner.svg"/>
            <t t-snippet="saas_dynamic_features.s_3d_features" t-thumbnail="/website/static/src/img/snippets_thumbs/s_features_grid.svg"/>
        </xpath>
    </template>
</odoo>
