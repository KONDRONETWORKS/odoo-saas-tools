<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="saas_client.SaasDashboard" owl="1">
        <div class="o_saas_dashboard h-100 overflow-auto bg-view">
            <div class="container-fluid py-4">
                <div class="row mb-4">
                    <div class="col-12">
                        <h1 class="display-4 text-primary">
                            <i class="fa fa-rocket me-2"/>SaaS Dashboard
                        </h1>
                        <p class="lead text-muted">Welcome to your immersive SaaS environment.</p>
                    </div>
                </div>
                
                <div class="row g-4">
                    <!-- Status Card -->
                    <div class="col-md-4">
                        <div class="card shadow-sm border-0 h-100">
                            <div class="card-body">
                                <h5 class="card-title text-success">
                                    <i class="fa fa-check-circle me-2"/>System Status
                                </h5>
                                <p class="card-text">Your instance is running smoothly.</p>
                                <div class="progress mt-3" style="height: 10px;">
                                    <div class="progress-bar bg-success" role="progressbar" style="width: 100%"></div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Announcement Card -->
                    <div class="col-md-8">
                        <div class="card shadow-sm border-0 h-100 bg-light">
                            <div class="card-body">
                                <h5 class="card-title text-info">
                                    <i class="fa fa-bullhorn me-2"/>Announcements
                                </h5>
                                <t t-if="state.announcement">
                                    <div class="alert alert-info border-0" role="alert">
                                        <t t-esc="state.announcement"/>
                                        <a t-if="state.announcementUrl" t-attr-href="state.announcementUrl" class="alert-link ms-2" target="_blank">Read more</a>
                                    </div>
                                </t>
                                <t t-else="">
                                    <p class="text-muted fst-italic">No new announcements at this time.</p>
                                </t>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Quick Actions -->
                <div class="row mt-4">
                    <div class="col-12">
                        <h3 class="mb-3">Quick Actions</h3>
                        <div class="d-flex gap-3">
                            <button class="btn btn-primary btn-lg px-4" t-on-click="onRefresh">
                                <i class="fa fa-refresh me-2"/>Refresh Data
                            </button>
                            <button class="btn btn-outline-secondary btn-lg px-4" t-on-click="onContactSupport">
                                <i class="fa fa-life-ring me-2"/>Contact Support
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </t>
</templates>
