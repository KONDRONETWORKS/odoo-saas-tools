<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_inherited_backup_ovh" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.backup_ovh</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="saas_server.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@id='saas_server_backup_settings']" position="inside">
                <div class="col-12 col-lg-6 o_setting_box">
                    <div class="o_setting_left_pane"/>
                    <div class="o_setting_right_pane">
                        <label for="saas_ovh_project_id" string="OVH Project ID"/>
                        <div class="text-muted mb-2">Identifiant du projet Public Cloud (serviceName).</div>
                        <div class="content-group mt16">
                            <field name="saas_ovh_project_id" placeholder="xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx"/>
                        </div>
                    </div>
                </div>
                <div class="col-12 col-lg-6 o_setting_box">
                    <div class="o_setting_left_pane"/>
                    <div class="o_setting_right_pane">
                        <label for="saas_ovh_storage_region" string="Région"/>
                        <div class="text-muted mb-2">Exemple : GRA (Gravelines), SBG (Strasbourg), BHS (Beauharnois).</div>
                        <div class="content-group mt16">
                            <field name="saas_ovh_storage_region" placeholder="GRA"/>
                        </div>
                    </div>
                </div>
                <div class="col-12 col-lg-6 o_setting_box">
                    <div class="o_setting_left_pane"/>
                    <div class="o_setting_right_pane">
                        <label for="saas_ovh_container_name" string="Container"/>
                        <div class="text-muted mb-2">Container Swift / bucket S3 compatible pour les sauvegardes.</div>
                        <div class="content-group mt16">
                            <field name="saas_ovh_container_name" placeholder="saas-backups"/>
                        </div>
                    </div>
                </div>
                <div class="col-12 col-lg-6 o_setting_box">
                    <div class="o_setting_left_pane"/>
                    <div class="o_setting_right_pane">
                        <label for="saas_ovh_application_key" string="Application Key"/>
                        <div class="content-group mt16">
                            <field name="saas_ovh_application_key"/>
                        </div>
                    </div>
                </div>
                <div class="col-12 col-lg-6 o_setting_box">
                    <div class="o_setting_left_pane"/>
                    <div class="o_setting_right_pane">
                        <label for="saas_ovh_application_secret" string="Application Secret"/>
                        <div class="content-group mt16">
                            <field name="saas_ovh_application_secret" password="True"/>
                        </div>
                    </div>
                </div>
                <div class="col-12 col-lg-6 o_setting_box">
                    <div class="o_setting_left_pane"/>
                    <div class="o_setting_right_pane">
                        <label for="saas_ovh_consumer_key" string="Consumer Key"/>
                        <div class="content-group mt16">
                            <field name="saas_ovh_consumer_key"/>
                        </div>
                    </div>
                </div>
            </xpath>
        </field>
    </record>
</odoo>
