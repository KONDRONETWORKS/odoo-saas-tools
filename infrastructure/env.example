# Configuration Odoo SaaS Tools - Production
# Copiez ce fichier vers .env dans le répertoire racine et modifiez les valeurs
# Usage: cp infrastructure/env.example .env && nano .env

# ============================================
# PostgreSQL
# ============================================
POSTGRES_DB=odoo
POSTGRES_USER=odoo
# ⚠️ Générez un mot de passe sécurisé avec: openssl rand -hex 32
POSTGRES_PASSWORD=odoo

# ============================================
# Odoo
# ============================================
# ⚠️ Générez un mot de passe admin sécurisé avec: openssl rand -hex 32
ODOO_ADMIN_PASSWD=admin
ODOO_DB_PASSWORD=${POSTGRES_PASSWORD}

# ============================================
# Domaine et Email
# ============================================
DOMAIN_NAME=saas.itexperts4africa.com
EMAIL=admin@itexperts4africa.com

# ============================================
# Configuration Serveur
# ============================================
# Nombre de workers (recommandé: 2-4 par CPU core)
WORKERS=4
MAX_CRON_THREADS=2

# Limites mémoire (en octets)
# 2 Go = 2147483648
# 4 Go = 4294967296
LIMIT_MEMORY_SOFT=2147483648
LIMIT_MEMORY_HARD=2684354560

# ============================================
# Sécurité
# ============================================
LIST_DB=False
PROXY_MODE=True

# ============================================
# Email SMTP Outlook/Exchange (Optionnel)
# ============================================
# Pour configurer l'envoi d'emails via Outlook/Exchange, renseignez les variables ci-dessous :
# SMTP_SERVER=smtp.office365.com
# SMTP_PORT=587
# SMTP_SSL=False
# SMTP_USER=support@itexperts4africa.com
# SMTP_PASSWORD=ITE4A2@@25


# ============================================
# AWS (Optionnel - si vous utilisez AWS)
# ============================================
# AWS_ACCESS_KEY_ID=your_access_key
# AWS_SECRET_ACCESS_KEY=your_secret_key
# AWS_REGION=eu-west-1
# AWS_S3_BUCKET=odoo-backups

# ============================================
# OVH (Optionnel - si vous utilisez OVH)
# ============================================
# OVH_APPLICATION_KEY=your_app_key
# OVH_APPLICATION_SECRET=your_app_secret
# OVH_CONSUMER_KEY=your_consumer_key
# OVH_ENDPOINT=ovh-eu

