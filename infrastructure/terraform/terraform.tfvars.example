# Exemple de fichier terraform.tfvars
# Copiez ce fichier vers terraform.tfvars et remplissez les valeurs

# Configuration de base
aws_region       = "us-east-1"
project_name     = "odoo-saas-tools"
environment      = "production" # ou "staging"

# Domaine
domain_name      = "saas.votredomaine.com"

# Infrastructure
instance_type    = "t3.xlarge"
db_instance_class = "db.t3.medium"
db_allocated_storage = 100

# Clé SSH
key_pair_name    = "votre-key-pair-aws"

# Auto Scaling
min_instances    = 2
max_instances    = 10
desired_capacity = 2

# Backup
enable_backup    = true
backup_retention_days = 7
enable_multi_az = true

# Logs
log_retention_days = 30

# Sécurité SSH (recommandé: votre IP uniquement)
allowed_ssh_cidr = "0.0.0.0/0" # À restreindre en production

# Tags additionnels
tags = {
  Owner       = "DevOps"
  Environment = "production"
  Project     = "OdooSaaS"
}
