# Configuration Nginx pour production AWS avec ALB
# Ce fichier est utilisé par le user-data script

upstream odoo {
    server 127.0.0.1:8069;
    keepalive 64;
}

# Redirection HTTP vers HTTPS (géré par ALB)
# Cette configuration est pour référence, l'ALB gère le SSL
server {
    listen 80;
    server_name _;
    
    # Health check pour ALB
    location /web/health {
        proxy_pass http://odoo;
        access_log off;
    }
    
    # Redirection vers HTTPS (si nécessaire)
    location / {
        return 301 https://$host$request_uri;
    }
}

# Configuration principale (derrière ALB)
server {
    listen 8069;
    server_name _;
    
    # Headers de sécurité
    add_header X-Frame-Options "SAMEORIGIN" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-XSS-Protection "1; mode=block" always;
    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
    
    client_max_body_size 200M;
    proxy_read_timeout 660s;
    proxy_connect_timeout 660s;
    proxy_send_timeout 660s;
    
    # Compression
    gzip on;
    gzip_vary on;
    gzip_min_length 1000;
    gzip_comp_level 6;
    gzip_types 
        text/plain 
        text/css 
        text/javascript 
        text/xml 
        text/x-component
        application/json 
        application/javascript 
        application/xml 
        application/rss+xml 
        application/rdf+xml
        font/truetype 
        font/opentype 
        application/vnd.ms-fontobject 
        image/svg+xml;
    gzip_disable "msie6";
    gzip_proxied any;
    
    # Cache des assets statiques
    location ~* \.(jpg|jpeg|png|gif|ico|css|js|woff|woff2|ttf|svg)$ {
        expires 30d;
        add_header Cache-Control "public, immutable";
        access_log off;
    }
    
    # Logs
    access_log /var/log/nginx/odoo-access.log;
    error_log /var/log/nginx/odoo-error.log;
    
    # Proxy vers Odoo
    location / {
        proxy_pass http://odoo;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Forwarded-Port $server_port;
        proxy_redirect off;
        
        # WebSocket support
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
    }
    
    # Long polling
    location /longpolling {
        proxy_pass http://odoo;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 3600s;
    }
    
    # WebSocket
    location /websocket {
        proxy_pass http://odoo;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_read_timeout 3600s;
    }
    
    # Health check
    location /web/health {
        proxy_pass http://odoo;
        access_log off;
    }
    
    # Statiques (si servis par Nginx)
    location /web/static/ {
        alias /opt/odoo-saas-tools/filestore/static/;
        expires 30d;
        add_header Cache-Control "public, immutable";
    }
}

