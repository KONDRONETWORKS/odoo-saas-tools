[options]
admin_passwd = admin
db_host = postgres
db_port = 5432
db_user = odoo
db_password = odoo
db_name = odoo
addons_path = /mnt/extra-addons/oca_addons/queue,/mnt/extra-addons/oca_addons/connector,/mnt/extra-addons/themes,/mnt/extra-addons/themes/theme_crest/theme_crest,/mnt/extra-addons/themes/theme_crest/crest_theme_core,/mnt/extra-addons/themes/theme_crest/odoo_gpt_chat,/mnt/extra-addons,/usr/lib/python3/dist-packages/odoo/addons
data_dir = /var/lib/odoo
xmlrpc_port = 8069
longpolling_port = 8072
log_level = info
logfile = /var/log/odoo/odoo.log
without_demo = True
workers = 3
max_cron_threads = 2
db_filter = .*

