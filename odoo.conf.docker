[options]
admin_passwd = admin
db_host = postgres
db_port = 5432
db_user = odoo
db_password = odoo
db_name = odoo
addons_path = /mnt/extra-addons,/usr/lib/python3/dist-packages/odoo/addons
data_dir = /var/lib/odoo/filestore
xmlrpc_port = 8069
longpolling_port = 8072
log_level = info
logfile = /var/log/odoo/odoo.log
without_demo = True
workers = 3
max_cron_threads = 2
db_filter = .*

