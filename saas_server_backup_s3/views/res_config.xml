<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_inherited_backup_ftp" model="ir.ui.view">
            <field name="name">res.config.settings.view.form.inherit.backup_s3</field>
            <field name="model">res.config.settings</field>
            <field name="priority" eval="20" />
            <field name="inherit_id" ref="base.res_config_settings_view_form" />
            <field name="arch" type="xml">
            <xpath expr="//div[@data-key='saas_server']" position="inside">
                <h3>AWS S3 Access</h3>
                <div class="row mt16 o_settings_container">
                    <div class="col-12 col-lg-12 o_setting_box">
                        <div class="o_setting_left_pane">
                            <field name="saas_s3_aws_accessid" style="width: 100%; max-width: 1000px;"/>
                        </div>
                        <div class="o_setting_right_pane">
                            <label for="saas_s3_aws_accessid"/>
                            <div class="text-muted">
                                AWS Access ID.
                            </div>
                        </div>
                    </div>
                    <div class="col-12 col-lg-12 o_setting_box">
                        <div class="o_setting_left_pane">
                            <field name="saas_s3_aws_accesskey" password="True" style="width: 100%; max-width: 1000px;"/>
                        </div>
                        <div class="o_setting_right_pane">
                            <label for="saas_s3_aws_accesskey"/>
                            <div class="text-muted">
                                AWS Secret Key.
                            </div>
                        </div>
                    </div>
                    <div class="col-12 col-lg-12 o_setting_box">
                        <div class="o_setting_left_pane">
                            <field name="saas_s3_aws_bucket" style="width: 100%; max-width: 1000px;"/>
                        </div>
                        <div class="o_setting_right_pane">
                            <label for="saas_s3_aws_bucket"/>
                            <div class="text-muted">
                                S3 Bucket.
                            </div>
                        </div>
                    </div>
                </div>
            </xpath>
            </field>
        </record>
</odoo>
