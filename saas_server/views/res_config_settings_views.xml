<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Vue de configuration pour SaaS Server -->
    <record id="res_config_settings_view_form_saas_server" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.saas_server</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <!-- Ajout du bloc de configuration SaaS Server après le dernier app_settings_block -->
            <xpath expr="//field[@name='company_id']" position="after">
                <div class="app_settings_block" data-string="SaaS Server" string="SaaS Server Settings" data-key="saas_server">
                    <h2>SaaS Server Configuration</h2>
                    <div class="row mt16 o_settings_container">
                        <div class="col-12 o_setting_box">
                            <div class="o_setting_left_pane">
                                <field name="saas_server_enable_backup" widget="boolean_toggle"/>
                            </div>
                            <div class="o_setting_right_pane">
                                <label for="saas_server_enable_backup"/>
                                <div class="text-muted">
                                    Enable automated backup for client databases
                                </div>
                            </div>
                        </div>
                        <div class="col-12 o_setting_box">
                            <div class="o_setting_left_pane">
                                <field name="saas_server_backup_frequency" options="{'no_create': True}"/>
                            </div>
                            <div class="o_setting_right_pane">
                                <label for="saas_server_backup_frequency"/>
                                <div class="text-muted">
                                    How often to backup client databases (hours)
                                </div>
                            </div>
                        </div>
                    </div>
                    
                    <div class="row mt16 o_settings_container">
                        <div class="col-12">
                            <h3>Backup Storage Options</h3>
                        </div>
                        <div class="col-12 o_setting_box">
                            <div class="o_setting_left_pane">
                                <field name="module_saas_server_backup_s3" widget="boolean_toggle"/>
                            </div>
                            <div class="o_setting_right_pane">
                                <label for="module_saas_server_backup_s3"/>
                                <div class="text-muted">
                                    Enable AWS S3 backup storage (requires saas_server_backup_s3 module)
                                </div>
                            </div>
                        </div>
                        <div class="col-12 o_setting_box">
                            <div class="o_setting_left_pane">
                                <field name="module_saas_server_backup_ftp" widget="boolean_toggle"/>
                            </div>
                            <div class="o_setting_right_pane">
                                <label for="module_saas_server_backup_ftp"/>
                                <div class="text-muted">
                                    Enable FTP backup storage (requires saas_server_backup_ftp module)
                                </div>
                            </div>
                        </div>
                    </div>
                    
                    <div class="row mt16 o_settings_container">
                        <div class="col-12">
                            <h3>DNS Management</h3>
                        </div>
                        <div class="col-12 o_setting_box">
                            <div class="o_setting_left_pane">
                                <field name="module_saas_sysadmin_aws_route53" widget="boolean_toggle"/>
                            </div>
                            <div class="o_setting_right_pane">
                                <label for="module_saas_sysadmin_aws_route53"/>
                                <div class="text-muted">
                                    Enable AWS Route53 DNS management
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </xpath>
        </field>
    </record>

    <!-- Action pour accéder aux paramètres -->
    <record id="action_saas_server_config_settings" model="ir.actions.act_window">
        <field name="name">SaaS Server Settings</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">res.config.settings</field>
        <field name="view_mode">form</field>
        <field name="target">inline</field>
        <field name="context">{'module': 'saas_server'}</field>
    </record>

    <!-- Menu pour accéder aux paramètres (supprimé pour éviter l'erreur de menu parent) -->
</odoo>
