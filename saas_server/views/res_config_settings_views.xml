<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Vue de configuration pour SaaS Server -->
    <record id="res_config_settings_view_form_saas_server" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.saas_server</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <!-- Ajout du bloc de configuration SaaS Server après le dernier app_settings_block -->
            <xpath expr="//field[@name='company_id']" position="after">
                <div class="app_settings_block" data-string="SaaS Server" string="SaaS Server Settings" data-key="saas_server">
                    <h2>SaaS Server Configuration</h2>
                    <div class="row mt16 o_settings_container">
                        <div class="col-12 o_setting_box">
                            <div class="o_setting_left_pane"/>
                            <div class="o_setting_right_pane">
                                <label for="saas_server_enable_backup" string="Enable Automated Backup"/>
                                <div class="text-muted mb-2">Enable automated backup for client databases. When enabled, backups will be created automatically according to the frequency settings below.</div>
                                <div class="content-group mt16">
                                    <field name="saas_server_enable_backup" widget="boolean_toggle"/>
                                </div>
                            </div>
                        </div>
                        <div class="col-12 col-lg-12 o_setting_box">
                            <div class="o_setting_left_pane"/>
                            <div class="o_setting_right_pane">
                                <label for="saas_server_backup_frequency" string="Backup Frequency (Hours)"/>
                                <div class="text-muted mb-2">How often to backup client databases, specified in hours. For example, set to 24 for daily backups or 12 for twice-daily backups.</div>
                                <div class="content-group mt16">
                                    <field name="saas_server_backup_frequency" options="{'no_create': True}" placeholder="24"/>
                                </div>
                            </div>
                        </div>
                    </div>
                    
                    <div class="row mt16 o_settings_container">
                        <div class="col-12">
                            <h3>Backup Storage Options</h3>
                        </div>
                        <div class="col-12 o_setting_box">
                            <div class="o_setting_left_pane"/>
                            <div class="o_setting_right_pane">
                                <label for="module_saas_server_backup_s3" string="AWS S3 Backup Storage"/>
                                <div class="text-muted mb-2">Enable AWS S3 backup storage. This requires the saas_server_backup_s3 module to be installed. Backups will be stored in your configured S3 bucket.</div>
                                <div class="content-group mt16">
                                    <field name="module_saas_server_backup_s3" widget="boolean_toggle"/>
                                </div>
                            </div>
                        </div>
                        <div class="col-12 o_setting_box">
                            <div class="o_setting_left_pane"/>
                            <div class="o_setting_right_pane">
                                <label for="module_saas_server_backup_ftp" string="SFTP Backup Storage"/>
                                <div class="text-muted mb-2">Enable SFTP backup storage. This requires the saas_server_backup_ftp module to be installed. Backups will be stored on your configured SFTP server.</div>
                                <div class="content-group mt16">
                                    <field name="module_saas_server_backup_ftp" widget="boolean_toggle"/>
                                </div>
                            </div>
                        </div>
                    </div>
                    
                    <div class="row mt16 o_settings_container">
                        <div class="col-12">
                            <h3>DNS Management</h3>
                        </div>
                        <div class="col-12 o_setting_box">
                            <div class="o_setting_left_pane"/>
                            <div class="o_setting_right_pane">
                                <label for="module_saas_sysadmin_aws_route53" string="AWS Route53 DNS Management"/>
                                <div class="text-muted mb-2">Enable AWS Route53 DNS management for automatic DNS configuration. This requires the saas_sysadmin_aws_route53 module to be installed.</div>
                                <div class="content-group mt16">
                                    <field name="module_saas_sysadmin_aws_route53" widget="boolean_toggle"/>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </xpath>
        </field>
    </record>

    <!-- Action pour accéder aux paramètres -->
    <record id="action_saas_server_config_settings" model="ir.actions.act_window">
        <field name="name">SaaS Server Settings</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">res.config.settings</field>
        <field name="view_mode">form</field>
        <field name="target">inline</field>
        <field name="context">{'module': 'saas_server'}</field>
    </record>

    <!-- Menu pour accéder aux paramètres (supprimé pour éviter l'erreur de menu parent) -->
</odoo>
