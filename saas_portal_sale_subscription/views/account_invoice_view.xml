<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="invoice_form" model="ir.ui.view">
            <field name="name">account.move.form.saas</field>
            <field name="model">account.move</field>
            <field name="inherit_id" ref="account.view_move_form" />
            <field name="arch" type="xml">
        <xpath expr="//field[@name='invoice_line_ids']/list/field[@name='product_id']" position="after">
            <field name="saas_plan_id" invisible="1" />
            <field name="saas_client_id" domain="[('partner_id', '=', parent.partner_id), ('plan_id', '=', saas_plan_id)]" />
        </xpath>
            </field>
        </record>
    <record id="view_invoice_line_form" model="ir.ui.view">
            <field name="name">account.move.line.form.saas</field>
            <field name="model">account.move.line</field>
            <field name="inherit_id" ref="account.view_move_line_form" />
            <field name="arch" type="xml">
            <field name="product_id" position="after">
            <field name="saas_client_id" />
            </field>
            </field>
        </record>
</odoo>
