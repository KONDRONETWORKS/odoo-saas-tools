<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="product_attribute_value_view_tree" model="ir.ui.view">
        <field name="name">product.attribute.value.view.tree.saas</field>
        <field name="model">product.attribute.value</field>
        <field name="inherit_id" ref="product.product_attribute_value_list" />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='name']" position="after">
                <field name="saas_code_value" />
            </xpath>
        </field>
    </record>
    <!-- Note: variants_tree_view removed - product.variants_tree_view doesn't exist in Odoo 18 -->
    <!-- The functionality is covered by product_attribute_value_view_tree above -->
</odoo>