<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_inherited_sys_aws" model="ir.ui.view">
            <field name="name">res.config.settings.view.form.inherit.sys_aws</field>
            <field name="model">res.config.settings</field>
            <field name="priority" eval="20" />
            <field name="inherit_id" ref="base.res_config_settings_view_form" />
            <field name="arch" type="xml">
            <xpath expr="//field[@name='company_id']" position="after">
                <div class="app_settings_block" data-string="AWS Configuration" string="AWS Configuration" data-key="saas_sysadmin_aws">
                    <h2>Sysadmin AWS Settings</h2>
                    <div class="row mt16 o_settings_container">
                        <div class="col-12 col-lg-12 o_setting_box">
                            <div class="o_setting_left_pane"/>
                            <div class="o_setting_right_pane">
                                <label for="saas_route53_aws_accessid" string="AWS Access ID"/>
                                <div class="text-muted mb-2">Your AWS Access Key ID for Route53 DNS management. This is the public part of your AWS credentials.</div>
                                <div class="content-group mt16">
                                    <field name="saas_route53_aws_accessid" placeholder="AKIAIOSFODNN7EXAMPLE"/>
                                </div>
                            </div>
                        </div>
                        <div class="col-12 col-lg-12 o_setting_box">
                            <div class="o_setting_left_pane"/>
                            <div class="o_setting_right_pane">
                                <label for="saas_route53_aws_accesskey" string="AWS Secret Key"/>
                                <div class="text-muted mb-2">Your AWS Secret Access Key for Route53 DNS management. This is the private part of your AWS credentials. Keep it secure.</div>
                                <div class="content-group mt16">
                                    <field name="saas_route53_aws_accesskey" password="True"/>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </xpath>
            </field>
        </record>
</odoo>
