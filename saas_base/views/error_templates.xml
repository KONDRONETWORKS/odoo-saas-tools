<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Page d'erreur user-friendly -->
    <template id="error_page" name="SaaS Error Page">
        <t t-call="website.layout">
            <t t-set="title">Erreur</t>
            <div class="container mt-4">
                <div class="row">
                    <div class="col-md-8 offset-md-2">
                        <div class="alert alert-danger">
                            <h3>
                                <i class="fa fa-exclamation-triangle"/> 
                                <t t-esc="error_code or 'Erreur'"/>
                            </h3>
                            <p t-esc="error_message or 'Une erreur s\'est produite.'"/>
                            
                            <t t-if="error_details">
                                <div class="mt-3">
                                    <strong>Détails :</strong>
                                    <pre t-esc="error_details"/>
                                </div>
                            </t>
                            
                            <div class="mt-4">
                                <a href="/" class="btn btn-primary">
                                    <i class="fa fa-home"/> Retour à l'accueil
                                </a>
                                <a href="/my/instances" class="btn btn-secondary">
                                    <i class="fa fa-list"/> Mes instances
                                </a>
                            </div>
                        </div>
                        
                        <div class="card mt-4">
                            <div class="card-header">
                                <h5>Besoin d'aide ?</h5>
                            </div>
                            <div class="card-body">
                                <p>
                                    Si le problème persiste, veuillez contacter notre support :
                                </p>
                                <ul>
                                    <li>Email : support@votre-domaine.com</li>
                                    <li>Code d'erreur : <code t-esc="error_code"/></li>
                                </ul>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </t>
    </template>
    
    <!-- Template pour erreurs JSON (API) -->
    <template id="error_json_response" name="SaaS Error JSON Response">
        <!-- Utilisé par les contrôleurs JSON pour formatage standardisé -->
    </template>
</odoo>
