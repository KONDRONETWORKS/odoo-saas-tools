FROM odoo:18

# Installer les dépendances système (binaires)
USER root
RUN apt-get update && apt-get install -y \
    git \
    && rm -rf /var/lib/apt/lists/*

# Installer les dépendances Python nécessaires pour les modules SaaS
RUN pip3 install --break-system-packages \
    oauthlib>=3.2.0 \
    redis>=5.0.0 \
    boto3>=1.34.0 \
    psycopg2-binary>=2.9.0 \
    requests>=2.31.0 \
    cachetools>=5.0.0 \
    ovh>=1.1.0 \
    pysftp>=0.2.9 \
    rotate_backups_s3>=0.3.0

# Revenir à l'utilisateur odoo
USER odoo

