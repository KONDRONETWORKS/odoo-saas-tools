<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_inherited_sys_ovh" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.sys_ovh</field>
        <field name="model">res.config.settings</field>
        <field name="priority" eval="25"/>
        <field name="inherit_id" ref="base.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='company_id']" position="after">
                <div class="app_settings_block" data-string="OVH Configuration" string="OVH Configuration" data-key="saas_sysadmin_ovh">
                    <h2>Intégration OVH DNS</h2>
                    <div class="row mt16 o_settings_container">
                        <div class="col-12 col-lg-6 o_setting_box">
                            <div class="o_setting_left_pane"/>
                            <div class="o_setting_right_pane">
                                <label for="saas_ovh_application_key" string="OVH Application Key"/>
                                <div class="text-muted mb-2">Identifiant public de l'application OVH.</div>
                                <div class="content-group mt16">
                                    <field name="saas_ovh_application_key" placeholder="APPKEY"/>
                                </div>
                            </div>
                        </div>
                        <div class="col-12 col-lg-6 o_setting_box">
                            <div class="o_setting_left_pane"/>
                            <div class="o_setting_right_pane">
                                <label for="saas_ovh_application_secret" string="OVH Application Secret"/>
                                <div class="text-muted mb-2">Secret associé. Gardez-le confidentiel.</div>
                                <div class="content-group mt16">
                                    <field name="saas_ovh_application_secret" password="True"/>
                                </div>
                            </div>
                        </div>
                        <div class="col-12 col-lg-6 o_setting_box">
                            <div class="o_setting_left_pane"/>
                            <div class="o_setting_right_pane">
                                <label for="saas_ovh_consumer_key" string="OVH Consumer Key"/>
                                <div class="text-muted mb-2">Générée lors de l'autorisation de l'application.</div>
                                <div class="content-group mt16">
                                    <field name="saas_ovh_consumer_key" placeholder="ck1abcd..."/>
                                </div>
                            </div>
                        </div>
                        <div class="col-12 col-lg-6 o_setting_box">
                            <div class="o_setting_left_pane"/>
                            <div class="o_setting_right_pane">
                                <label for="saas_ovh_endpoint" string="Endpoint"/>
                                <div class="text-muted mb-2">Choisissez l'API correspondant à votre région OVH.</div>
                                <div class="content-group mt16">
                                    <field name="saas_ovh_endpoint" widget="selection"/>
                                </div>
                            </div>
                        </div>
                        <div class="col-12 col-lg-12 o_setting_box">
                            <div class="o_setting_left_pane"/>
                            <div class="o_setting_right_pane">
                                <label for="saas_ovh_root_domain" string="Domaine racine"/>
                                <div class="text-muted mb-2">Sous-domaine utilisé pour vos instances (ex: saas.example.com).</div>
                                <div class="content-group mt16">
                                    <field name="saas_ovh_root_domain" placeholder="saas.example.com"/>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </xpath>
        </field>
    </record>
</odoo>
