<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Tree View for Monitoring Metrics -->
    <record id="view_monitoring_tree" model="ir.ui.view">
        <field name="name">saas_portal.monitoring.tree</field>
        <field name="model">saas_portal.monitoring</field>
        <field name="arch" type="xml">
            <tree string="Monitoring Metrics" default_order="timestamp desc">
                <field name="client_id"/>
                <field name="metric_type"/>
                <field name="value"/>
                <field name="status" widget="badge" 
                    decoration-success="status == 'ok'"
                    decoration-warning="status == 'warning'"
                    decoration-danger="status in ('critical', 'down')"/>
                <field name="threshold_warning"/>
                <field name="threshold_critical"/>
                <field name="timestamp"/>
            </tree>
        </field>
    </record>

    <!-- Form View for Monitoring Metrics -->
    <record id="view_monitoring_form" model="ir.ui.view">
        <field name="name">saas_portal.monitoring.form</field>
        <field name="model">saas_portal.monitoring</field>
        <field name="arch" type="xml">
            <form string="Monitoring Metric">
                <sheet>
                    <group>
                        <group>
                            <field name="client_id"/>
                            <field name="server_id" readonly="1"/>
                            <field name="metric_type"/>
                            <field name="value"/>
                        </group>
                        <group>
                            <field name="status" widget="badge"
                                decoration-success="status == 'ok'"
                                decoration-warning="status == 'warning'"
                                decoration-danger="status in ('critical', 'down')"/>
                            <field name="threshold_warning"/>
                            <field name="threshold_critical"/>
                            <field name="timestamp"/>
                        </group>
                    </group>
                    <group>
                        <field name="note" placeholder="Notes about this metric..."/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Graph View for Monitoring Metrics -->
    <record id="view_monitoring_graph" model="ir.ui.view">
        <field name="name">saas_portal.monitoring.graph</field>
        <field name="model">saas_portal.monitoring</field>
        <field name="arch" type="xml">
            <graph string="Monitoring Metrics" type="line">
                <field name="timestamp" type="row"/>
                <field name="value" type="measure"/>
            </graph>
        </field>
    </record>

    <!-- Pivot View for Monitoring Metrics -->
    <record id="view_monitoring_pivot" model="ir.ui.view">
        <field name="name">saas_portal.monitoring.pivot</field>
        <field name="model">saas_portal.monitoring</field>
        <field name="arch" type="xml">
            <pivot string="Monitoring Metrics">
                <field name="metric_type" type="col"/>
                <field name="client_id" type="row"/>
                <field name="value" type="measure"/>
            </pivot>
        </field>
    </record>

    <!-- Action for Monitoring Metrics -->
    <record id="action_monitoring_metrics" model="ir.actions.act_window">
        <field name="name">Monitoring Metrics</field>
        <field name="res_model">saas_portal.monitoring</field>
        <field name="view_mode">tree,graph,pivot,form</field>
        <field name="context">{'search_default_group_by_metric_type': 1}</field>
        <field name="help" type="html">
            <p class="oe_view_nocontent_create">
                Click to add a new monitoring metric.
            </p>
            <p>
                Monitoring metrics are collected automatically via scheduled tasks.
                You can also collect metrics manually from the client form.
            </p>
        </field>
    </record>

    <!-- Menu Item -->
    <menuitem id="menu_monitoring_metrics"
        name="Monitoring Metrics"
        parent="saas_portal.menu_saas"
        action="action_monitoring_metrics"
        sequence="50"/>
</odoo>
