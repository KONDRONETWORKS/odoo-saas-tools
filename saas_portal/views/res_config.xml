<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_inherited_saas_portal" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.saas_portal</field>
        <field name="model">res.config.settings</field>
        <field name="priority" eval="20" />
        <field name="inherit_id" ref="base.res_config_settings_view_form" />
        <field name="arch" type="xml">
            <xpath expr="//div[@class='settings']" position="inside">
                <div class="app_settings_block" id="saas_portal" data-string="Saas Portal"
                    string="Saas Portal" data-key="saas_portal">
                    <h2>Domain</h2>
                    <div class="row mt16 o_settings_container">
                        <div class="col-12 col-lg-12 o_setting_box">
                            <div class="o_setting_left_pane"/>
                            <div class="o_setting_right_pane">
                                <label for="base_saas_domain" string="Base SaaS Domain"/>
                                <div class="text-muted mb-2">Set base domain name for your SaaS environment. For example: odoo.com</div>
                                <div class="content-group mt16">
                                    <field name="base_saas_domain" placeholder="odoo.com"/>
                                </div>
                            </div>
                        </div>
                    </div>
                    <h2>Error pages</h2>
                    <div class="row mt16 o_settings_container">
                        <div class="col-12 col-lg-12 o_setting_box">
                            <div class="o_setting_left_pane"/>
                            <div class="o_setting_right_pane">
                                <label for="page_for_maximumdb" string="Maximum Databases Error Page"/>
                                <div class="text-muted mb-2">Redirection URL for maximum non-trial databases limit exception.</div>
                                <div class="content-group mt16">
                                    <field name="page_for_maximumdb"/>
                                </div>
                            </div>
                        </div>
                        <div class="col-12 col-lg-12 o_setting_box">
                            <div class="o_setting_left_pane"/>
                            <div class="o_setting_right_pane">
                                <label for="page_for_maximumtrialdb" string="Maximum Trial Databases Error Page"/>
                                <div class="text-muted mb-2">Redirection URL for maximum trial databases limit exception.</div>
                                <div class="content-group mt16">
                                    <field name="page_for_maximumtrialdb"/>
                                </div>
                            </div>
                        </div>
                        <div class="col-12 col-lg-12 o_setting_box">
                            <div class="o_setting_left_pane"/>
                            <div class="o_setting_right_pane">
                                <label for="page_for_nonfree_subdomains" string="Non-Free Subdomains Error Page"/>
                                <div class="text-muted mb-2">Redirection URL from /page/start when subdomains is not free and not paid.</div>
                                <div class="content-group mt16">
                                    <field name="page_for_nonfree_subdomains"/>
                                </div>
                            </div>
                        </div>
                    </div>
                    <h2>Notifications</h2>
                    <div class="row mt16 o_settings_container">
                        <div class="col-12 col-lg-12 o_setting_box">
                            <div class="o_setting_left_pane"/>
                            <div class="o_setting_right_pane">
                                <label for="expiration_notify_in_advance" string="Expiration Notification (Days)"/>
                                <div class="text-muted mb-2">Notify partners when less than the defined number of days left before expiration.</div>
                                <div class="content-group mt16">
                                    <field name="expiration_notify_in_advance" placeholder="7"/>
                                </div>
                            </div>
                        </div>
                    </div>
                    <h2>Features</h2>
                    <div class="row mt16 o_settings_container">
                        <div class="col-xs-12 col-md-6 o_setting_box">
                            <div class="o_setting_left_pane"/>
                            <div class="o_setting_right_pane">
                                <label for="module_saas_portal_sale_online" string="SaaS Portal Sale Online"/>
                                <div class="text-muted mb-2">Enable the saas_portal_sale_online module for online sales functionality.</div>
                                <div class="content-group mt16">
                                    <field name="module_saas_portal_sale_online" widget="boolean_toggle"/>
                                </div>
                            </div>
                        </div>
                        <div class="col-xs-12 col-md-6 o_setting_box">
                            <div class="o_setting_left_pane"/>
                            <div class="o_setting_right_pane">
                                <label for="module_saas_server_backup_rotate" string="SaaS Server Backup Rotate"/>
                                <div class="text-muted mb-2">Enable the saas_server_backup_rotate module for automatic backup rotation.</div>
                                <div class="content-group mt16">
                                    <field name="module_saas_server_backup_rotate" widget="boolean_toggle"/>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </xpath>
        </field>
    </record>
    <record id="action_saas_portal_config_settings" model="ir.actions.act_window">
        <field name="name">Settings</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">res.config.settings</field>
        <field name="view_id" ref="res_config_settings_view_form_inherited_saas_portal" />
        <field name="view_mode">form</field>
        <field name="target">inline</field>
        <field name="context">{'module' : 'saas_portal'}</field>
    </record>
    <menuitem id="menu_saas_portal_general_settings" name="Settings"
        parent="menu_saas_portal_config" sequence="0" action="action_saas_portal_config_settings"
        groups="base.group_system" />
</odoo>