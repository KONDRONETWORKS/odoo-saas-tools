<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Tree View for Quota Usage -->
    <record id="view_quota_usage_tree" model="ir.ui.view">
        <field name="name">saas_portal.quota_usage.tree</field>
        <field name="model">saas_portal.quota_usage</field>
        <field name="arch" type="xml">
            <tree string="Quota Usage" default_order="timestamp desc">
                <field name="client_id"/>
                <field name="quota_type"/>
                <field name="current_usage"/>
                <field name="limit"/>
                <field name="usage_percentage" widget="progressbar"/>
                <field name="status" widget="badge"
                    decoration-success="status == 'ok'"
                    decoration-warning="status == 'warning'"
                    decoration-danger="status in ('alert', 'blocked')"/>
                <field name="alert_sent"/>
                <field name="timestamp"/>
            </tree>
        </field>
    </record>

    <!-- Form View for Quota Usage -->
    <record id="view_quota_usage_form" model="ir.ui.view">
        <field name="name">saas_portal.quota_usage.form</field>
        <field name="model">saas_portal.quota_usage</field>
        <field name="arch" type="xml">
            <form string="Quota Usage">
                <sheet>
                    <group>
                        <group>
                            <field name="client_id"/>
                            <field name="quota_type"/>
                            <field name="current_usage"/>
                            <field name="limit"/>
                        </group>
                        <group>
                            <field name="usage_percentage" widget="progressbar"/>
                            <field name="status" widget="badge"
                                decoration-success="status == 'ok'"
                                decoration-warning="status == 'warning'"
                                decoration-danger="status in ('alert', 'blocked')"/>
                            <field name="alert_sent"/>
                            <field name="timestamp"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Graph View for Quota Usage -->
    <record id="view_quota_usage_graph" model="ir.ui.view">
        <field name="name">saas_portal.quota_usage.graph</field>
        <field name="model">saas_portal.quota_usage</field>
        <field name="arch" type="xml">
            <graph string="Quota Usage" type="line">
                <field name="timestamp" type="row"/>
                <field name="current_usage" type="measure"/>
            </graph>
        </field>
    </record>

    <!-- Action for Quota Usage -->
    <record id="action_quota_usage" model="ir.actions.act_window">
        <field name="name">Quota Usage</field>
        <field name="res_model">saas_portal.quota_usage</field>
        <field name="view_mode">tree,graph,form</field>
        <field name="context">{'search_default_group_by_quota_type': 1}</field>
        <field name="help" type="html">
            <p class="oe_view_nocontent_create">
                Quota usage is tracked automatically.
            </p>
            <p>
                This view shows the quota usage history for all clients.
            </p>
        </field>
    </record>

    <!-- Menu Item -->
    <menuitem id="menu_quota_usage"
        name="Quota Usage"
        parent="saas_portal.menu_saas"
        action="action_quota_usage"
        sequence="55"/>
</odoo>
