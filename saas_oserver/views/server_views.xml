<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Vues serveurs -->
    <record id="view_saas_server_list" model="ir.ui.view">
        <field name="name">saas.oserver.list</field>
        <field name="model">saas.oserver</field>
        <field name="arch" type="xml">
            <list string="Servers">
                <field name="name"/>
                <field name="host"/>
                <field name="state"/>
                <field name="current_instances"/>
                <field name="health_status"/>
            </list>
        </field>
    </record>
    
    <record id="action_saas_server" model="ir.actions.act_window">
        <field name="name">SaaS Servers</field>
        <field name="res_model">saas.oserver</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
