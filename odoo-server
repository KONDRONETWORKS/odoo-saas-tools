        elif model == 'saas_portal.server' and method == 'search':
            return [1]  # ID serveur simulé
        elif model == 'saas_portal.plan' and method == 'create':
            return 1  # ID plan simulé
        elif model == 'saas_portal.database' and method == 'create':
            return 1  # ID database simulé
        
        return True

class OdooHandler(BaseHTTPRequestHandler):
    def __init__(self, *args, **kwargs):
        self.odoo_handler = OdooXMLRPCHandler()
        super().__init__(*args, **kwargs)
    
    def do_GET(self):
        if self.path == '/xmlrpc/2/common':
            self.send_response(200)
            self.send_header('Content-type', 'application/json')
            self.end_headers()
            response = {
                "jsonrpc": "2.0",
                "id": None,
                "result": {
                    "server_version": "18.0",
                    "server_version_info": [18, 0, 0, "final", 0, ""],
                    "server_serie": "18.0",
                    "protocol_version": 1
                }
            }
            self.wfile.write(json.dumps(response).encode())
        else:
            self.send_response(404)
            self.end_headers()
    
    def do_POST(self):
        if self.path == '/xmlrpc/2/db':
            self.send_response(200)
            self.send_header('Content-type', 'text/xml')
            self.end_headers()
            
            # Lire les données XML
            content_length = int(self.headers['Content-Length'])
            post_data = self.rfile.read(content_length)
            
            try:
                # Parser la requête XML-RPC
                params, method = xmlrpc.client.loads(post_data)
                
                if method == 'create_database':
                    result = self.odoo_handler.create_database(*params)
                elif method == 'list':
                    result = self.odoo_handler.list()
                else:
                    result = True
                
                # Créer la réponse XML-RPC
                response = xmlrpc.client.dumps((result,), methodresponse=True)
                self.wfile.write(response.encode())
                
            except Exception as e:
                print(f"Erreur XML-RPC: {e}")
                error_response = xmlrpc.client.dumps(xmlrpc.client.Fault(1, str(e)))
                self.wfile.write(error_response.encode())
                
        elif self.path == '/xmlrpc/2/object':
            self.send_response(200)
            self.send_header('Content-type', 'text/xml')
            self.end_headers()
            
            # Lire les données XML
            content_length = int(self.headers['Content-Length'])
            post_data = self.rfile.read(content_length)
            
            try:
                # Parser la requête XML-RPC
                params, method = xmlrpc.client.loads(post_data)
                
                if method == 'execute_kw':
                    result = self.odoo_handler.execute_kw(*params)
                else:
                    result = []
                
                # Créer la réponse XML-RPC
                response = xmlrpc.client.dumps((result,), methodresponse=True)
                self.wfile.write(response.encode())
                
            except Exception as e:
                print(f"Erreur XML-RPC: {e}")
                error_response = xmlrpc.client.dumps(xmlrpc.client.Fault(1, str(e)))
                self.wfile.write(error_response.encode())
        else:
            self.send_response(404)
            self.end_headers()
    
    def log_message(self, format, *args):
        # Supprimer les logs HTTP par défaut
        pass

def check_port(port):
    """Vérifier si un port est disponible"""
    sock = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
    result = sock.connect_ex(('127.0.0.1', port))
    sock.close()
    return result == 0

def main():
    port = 8069
    if len(sys.argv) > 1:
        for arg in sys.argv[1:]:
            if arg.startswith('--xmlrpc-port='):
                port = int(arg.split('=')[1])
    
    if check_port(port):
        print(f"Port {port} déjà utilisé")
        sys.exit(1)
    
    print(f"Démarrage du serveur Odoo simulé sur le port {port}")
    
    try:
        server = HTTPServer(('127.0.0.1', port), OdooHandler)
        print(f"Serveur démarré sur http://127.0.0.1:{port}")
        server.serve_forever()
    except KeyboardInterrupt:
        print("\nArrêt du serveur")
        server.shutdown()
    except Exception as e:
        print(f"Erreur: {e}")
        sys.exit(1)

if __name__ == "__main__":
    main()