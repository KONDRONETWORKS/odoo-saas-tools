        self.databases[db_name] = {
            'demo': demo,
            'lang': lang,
            'admin_password': admin_password,
            'created_at': time.time()
        }
        return True
    
    def list(self):
        """Lister les bases de données"""
        return list(self.databases.keys())
    
    def authenticate(self, db_name, username, password, user_agent_env):
        """Simuler l'authentification"""
        if db_name in self.databases:
            return 1  # ID utilisateur simulé
        return False
    
    def execute_kw(self, db_name, uid, password, model, method, args, kwargs):
        """Simuler l'exécution de méthodes Odoo"""
        print(f"Exécution: {model}.{method} avec args: {args}, kwargs: {kwargs}")
        
        if model == 'ir.module.module' and method == 'search':
