<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_inherited_saas_portal" model="ir.ui.view">
            <field name="name">res.config.settings.view.form.inherit.saas_portal</field>
            <field name="model">res.config.settings</field>
            <field name="priority" eval="20" />
            <field name="inherit_id" ref="base.res_config_settings_view_form" />
            <field name="arch" type="xml">
            <xpath expr="//div[@data-key='saas_server']" position="inside">
                <h3>Rotate Backup Settings</h3>
                <div class="row mt16 o_settings_container">
                    <div class="col-12 col-lg-12 o_setting_box">
                        <div class="o_setting_left_pane"/>
                        <div class="o_setting_right_pane">
                            <label for="backup_rotate_unlimited" string="Enable Unlimited Backups"/>
                            <div class="text-muted mb-2">Enable unlimited backups to disable rotation. When enabled, all backups will be kept without any automatic deletion.</div>
                            <div class="content-group mt16">
                                <field name="backup_rotate_unlimited" widget="boolean_toggle"/>
                            </div>
                        </div>
                    </div>
                    <div class="col-12 col-lg-12 o_setting_box">
                        <div class="o_setting_left_pane"/>
                        <div class="o_setting_right_pane">
                            <label for="backup_rotate_yearly" string="Number of Yearly Backups"/>
                            <div class="text-muted mb-2">Set the number of yearly backups to preserve during rotation. Older yearly backups will be automatically deleted.</div>
                            <div class="content-group mt16">
                                <field name="backup_rotate_yearly" placeholder="2" invisible="backup_rotate_unlimited"/>
                            </div>
                        </div>
                    </div>
                    <div class="col-12 col-lg-12 o_setting_box">
                        <div class="o_setting_left_pane"/>
                        <div class="o_setting_right_pane">
                            <label for="backup_rotate_monthly" string="Number of Monthly Backups"/>
                            <div class="text-muted mb-2">Set the number of monthly backups to preserve during rotation. Older monthly backups will be automatically deleted.</div>
                            <div class="content-group mt16">
                                <field name="backup_rotate_monthly" placeholder="12" invisible="backup_rotate_unlimited"/>
                            </div>
                        </div>
                    </div>
                    <div class="col-12 col-lg-12 o_setting_box">
                        <div class="o_setting_left_pane"/>
                        <div class="o_setting_right_pane">
                            <label for="backup_rotate_weekly" string="Number of Weekly Backups"/>
                            <div class="text-muted mb-2">Set the number of weekly backups to preserve during rotation. Older weekly backups will be automatically deleted.</div>
                            <div class="content-group mt16">
                                <field name="backup_rotate_weekly" placeholder="4" invisible="backup_rotate_unlimited"/>
                            </div>
                        </div>
                    </div>
                    <div class="col-12 col-lg-12 o_setting_box">
                        <div class="o_setting_left_pane"/>
                        <div class="o_setting_right_pane">
                            <label for="backup_rotate_daily" string="Number of Daily Backups"/>
                            <div class="text-muted mb-2">Set the number of daily backups to preserve during rotation. Older daily backups will be automatically deleted.</div>
                            <div class="content-group mt16">
                                <field name="backup_rotate_daily" placeholder="7" invisible="backup_rotate_unlimited"/>
                            </div>
                        </div>
                    </div>
                    <div class="col-12 col-lg-12 o_setting_box">
                        <div class="o_setting_left_pane"/>
                        <div class="o_setting_right_pane">
                            <label for="backup_rotate_hourly" string="Number of Hourly Backups"/>
                            <div class="text-muted mb-2">Set the number of hourly backups to preserve during rotation. Older hourly backups will be automatically deleted.</div>
                            <div class="content-group mt16">
                                <field name="backup_rotate_hourly" placeholder="24" invisible="backup_rotate_unlimited"/>
                            </div>
                        </div>
                    </div>
                </div>
            </xpath>
            </field>
        </record>
</odoo>
