<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_inherited_sys_mailgun" model="ir.ui.view">
            <field name="name">res.config.settings.view.form.inherit.sys_maigun</field>
            <field name="model">res.config.settings</field>
            <field name="priority" eval="20" />
            <field name="inherit_id" ref="base.res_config_settings_view_form" />
            <field name="arch" type="xml">
            <xpath expr="//field[@name='company_id']" position="after">
                <div class="app_settings_block" data-string="Mailgun Configuration" string="Mailgun Configuration" data-key="saas_sysadmin_mailgun">
                    <h2>Sysadmin Mailgun Settings</h2>
                    <div class="row mt16 o_settings_container">
                        <div class="col-12 col-lg-12 o_setting_box">
                            <div class="o_setting_left_pane"/>
                            <div class="o_setting_right_pane">
                                <label for="saas_mailgun_api_key" string="Mailgun API Key"/>
                                <div class="text-muted mb-2">Your Mailgun API key for email service integration. This key is used to authenticate with Mailgun's API for sending emails.</div>
                                <div class="content-group mt16">
                                    <field name="saas_mailgun_api_key" password="True" placeholder="key-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"/>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </xpath>
            </field>
        </record>
</odoo>
