<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Groupes de sécurité -->
        <record id="group_kondro_user" model="res.groups">
            <field name="name">KONDRO / Utilisateur</field>
            <field name="category_id" ref="base.module_category_sales"/>
        </record>
        
        <record id="group_kondro_manager" model="res.groups">
            <field name="name">KONDRO / Gestionnaire</field>
