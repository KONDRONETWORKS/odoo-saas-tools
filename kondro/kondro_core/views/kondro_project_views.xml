<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Vue Kanban des Projets -->
    <record id="view_kondro_project_kanban" model="ir.ui.view">
        <field name="name">kondro.project.kanban</field>
        <field name="model">kondro.project</field>
        <field name="arch" type="xml">
            <kanban default_group_by="status" class="o_kanban_dashboard">
                <field name="id"/>
                <field name="name"/>
                <field name="client_id"/>
                <field name="project_type"/>
                <field name="status"/>
                <field name="priority"/>
                <field name="budget"/>
                <field name="engaged_amount"/>
                <field name="paid_amount"/>
                <field name="margin"/>
                <field name="progress"/>
                <field name="commercial_id"/>
                <field name="project_manager_id"/>
                <templates>
                    <t t-name="kanban-box">
                        <div class="oe_kanban_card oe_kanban_global_click">
                            <div class="o_kanban_card_header">
                                <div class="o_kanban_card_header_title">
                                    <div class="o_primary">
                                        <field name="name"/>
                                    </div>
                                    <div class="o_secondary">
                                        <field name="client_id"/>
                                    </div>
                                </div>
                                <div class="o_kanban_card_header_top">
                                    <div class="badge badge-pill" t-attf-class="badge-#{record.priority.raw_value === 'urgent' ? 'danger' : record.priority.raw_value === 'high' ? 'warning' : 'info'}">
                                        <field name="priority"/>
                                    </div>
                                </div>
                            </div>
                            <div class="o_kanban_card_content">
                                <div class="row">
                                    <div class="col-6">
                                        <strong>Type:</strong> <field name="project_type"/>
                                    </div>
                                    <div class="col-6">
                                        <strong>Budget:</strong> <field name="budget"/>
                                    </div>
                                </div>
                                <div class="row mt-2">
                                    <div class="col-12">
                                        <div class="progress">
                                            <div class="progress-bar" role="progressbar" t-attf-style="width: #{record.progress.raw_value}%" t-attf-aria-valuenow="#{record.progress.raw_value}">
                                                <field name="progress"/>%
                                            </div>
                                        </div>
                                    </div>
                                </div>
                                <div class="row mt-2">
                                    <div class="col-6">
                                        <small>Engagé: <field name="engaged_amount"/></small>
                                    </div>
                                    <div class="col-6">
                                        <small>Payé: <field name="paid_amount"/></small>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- Vue Liste des Projets -->
    <record id="view_kondro_project_tree" model="ir.ui.view">
        <field name="name">kondro.project.tree</field>
        <field name="model">kondro.project</field>
        <field name="arch" type="xml">
            <list string="Projets" decoration-info="status == 'opportunity'" decoration-warning="status == 'in_progress'" decoration-success="status == 'delivered'">
                <field name="name"/>
                <field name="client_id"/>
                <field name="project_type"/>
                <field name="status"/>
                <field name="priority"/>
                <field name="commercial_id"/>
                <field name="project_manager_id"/>
                <field name="budget" sum="Total Budget"/>
                <field name="engaged_amount" sum="Total Engagé"/>
                <field name="paid_amount" sum="Total Payé"/>
                <field name="margin" sum="Total Marge"/>
                <field name="progress"/>
            </list>
        </field>
    </record>

    <!-- Vue Formulaire des Projets -->
    <record id="view_kondro_project_form" model="ir.ui.view">
        <field name="name">kondro.project.form</field>
        <field name="model">kondro.project</field>
        <field name="arch" type="xml">
            <form string="Projet">
                <header>
                    <button name="action_view_expenses" string="Dépenses" type="object" class="oe_highlight"/>
                    <button name="action_view_documents" string="Documents" type="object"/>
                    <field name="status" widget="statusbar" statusbar_visible="draft,opportunity,in_progress,validation,delivered"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_expenses" type="object" class="oe_stat_button" icon="fa-money">
                            <field name="expense_count" widget="statinfo" string="Dépenses"/>
                        </button>
                        <button name="action_view_documents" type="object" class="oe_stat_button" icon="fa-file">
                            <field name="document_count" widget="statinfo" string="Documents"/>
                        </button>
                    </div>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="client_id" options="{'no_create': True}"/>
                            <field name="commercial_dossier_id" options="{'no_create': True}"/>
                            <field name="project_type"/>
                            <field name="priority"/>
                        </group>
                        <group>
                            <field name="commercial_id"/>
                            <field name="project_manager_id"/>
                            <field name="lead_engineer_id"/>
                            <field name="team_member_ids" widget="many2many_tags"/>
                        </group>
                    </group>
                    <group>
                        <group>
                            <field name="start_date"/>
                            <field name="end_date"/>
                            <field name="actual_start_date"/>
                            <field name="actual_end_date"/>
                        </group>
                        <group>
                            <field name="budget"/>
                            <field name="engaged_amount" readonly="1"/>
                            <field name="paid_amount" readonly="1"/>
                            <field name="margin" readonly="1"/>
                            <field name="currency_id" invisible="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Description">
                            <field name="description" placeholder="Description du projet..."/>
                        </page>
                        <page string="Progression">
                            <group>
                                <field name="progress" widget="progressbar"/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- Action pour les Projets -->
    <record id="action_kondro_project" model="ir.actions.act_window">
        <field name="name">Projets KONDRO</field>
        <field name="res_model">kondro.project</field>
        <field name="view_mode">kanban,tree,form</field>
        <field name="context">{'search_default_group_by_status': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Créer un nouveau projet
            </p>
        </field>
    </record>
</odoo>
