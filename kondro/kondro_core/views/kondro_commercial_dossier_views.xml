<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Vue Kanban des Dossiers Commerciaux -->
    <record id="view_kondro_commercial_dossier_kanban" model="ir.ui.view">
        <field name="name">kondro.commercial.dossier.kanban</field>
        <field name="model">kondro.commercial.dossier</field>
        <field name="arch" type="xml">
            <kanban default_group_by="state" class="o_kanban_dashboard">
                <field name="id"/>
                <field name="name"/>
                <field name="client_id"/>
                <field name="state"/>
                <field name="budget"/>
                <field name="engaged_amount"/>
                <field name="paid_amount"/>
                <field name="margin"/>
                <field name="commercial_id"/>
                <templates>
                    <t t-name="kanban-box">
                        <div class="oe_kanban_card oe_kanban_global_click">
                            <div class="o_kanban_card_header">
                                <div class="o_kanban_card_header_title">
                                    <div class="o_primary">
                                        <field name="name"/>
                                    </div>
                                    <div class="o_secondary">
                                        <field name="client_id"/>
                                    </div>
                                </div>
                            </div>
                            <div class="o_kanban_card_content">
                                <div class="row">
                                    <div class="col-12">
                                        <strong>Budget:</strong> <field name="budget"/>
                                    </div>
                                </div>
                                <div class="row mt-2">
                                    <div class="col-6">
                                        <small>Engagé: <field name="engaged_amount"/></small>
                                    </div>
                                    <div class="col-6">
                                        <small>Payé: <field name="paid_amount"/></small>
                                    </div>
                                </div>
                                <div class="row mt-2">
                                    <div class="col-12">
                                        <strong>Marge:</strong> <field name="margin"/>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- Vue Liste des Dossiers -->
    <record id="view_kondro_commercial_dossier_tree" model="ir.ui.view">
        <field name="name">kondro.commercial.dossier.tree</field>
        <field name="model">kondro.commercial.dossier</field>
        <field name="arch" type="xml">
            <list string="Dossiers Commerciaux">
                <field name="name"/>
                <field name="client_id"/>
                <field name="state"/>
                <field name="commercial_id"/>
                <field name="project_manager_id"/>
                <field name="budget" sum="Total Budget"/>
                <field name="engaged_amount" sum="Total Engagé"/>
                <field name="paid_amount" sum="Total Payé"/>
                <field name="margin" sum="Total Marge"/>
                <field name="project_count"/>
            </list>
        </field>
    </record>

    <!-- Vue Formulaire des Dossiers -->
    <record id="view_kondro_commercial_dossier_form" model="ir.ui.view">
        <field name="name">kondro.commercial.dossier.form</field>
        <field name="model">kondro.commercial.dossier</field>
        <field name="arch" type="xml">
            <form string="Dossier Commercial">
                <header>
                    <button name="action_view_projects" string="Projets" type="object" class="oe_highlight"/>
                    <button name="action_view_documents" string="Documents" type="object"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,proposal,won,in_progress,delivered,closed"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_projects" type="object" class="oe_stat_button" icon="fa-tasks">
                            <field name="project_count" widget="statinfo" string="Projets"/>
                        </button>
                        <button name="action_view_documents" type="object" class="oe_stat_button" icon="fa-file">
                            <field name="document_count" widget="statinfo" string="Documents"/>
                        </button>
                    </div>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="client_id" options="{'no_create': True}"/>
                            <field name="nature"/>
                            <field name="duration"/>
                        </group>
                        <group>
                            <field name="commercial_id"/>
                            <field name="project_manager_id"/>
                            <field name="lead_engineer_id"/>
                        </group>
                    </group>
                    <group>
                        <group>
                            <field name="budget"/>
                            <field name="engaged_amount" readonly="1"/>
                            <field name="paid_amount" readonly="1"/>
                            <field name="margin" readonly="1"/>
                            <field name="currency_id" invisible="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Description">
                            <field name="description" placeholder="Description du projet..."/>
                        </page>
                        <page string="Documents">
                            <field name="document_ids" widget="many2many_binary"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- Action pour les Dossiers Commerciaux -->
    <record id="action_kondro_commercial_dossier" model="ir.actions.act_window">
        <field name="name">Dossiers Commerciaux</field>
        <field name="res_model">kondro.commercial.dossier</field>
        <field name="view_mode">kanban,tree,form</field>
        <field name="context">{'search_default_group_by_state': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Créer un nouveau dossier commercial
            </p>
        </field>
    </record>
</odoo>
