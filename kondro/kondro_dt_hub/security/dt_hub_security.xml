<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="group_kondro_dt_user" model="res.groups">
            <field name="name">Kondro - Directeur Technique (Utilisateur)</field>
            <field name="category_id" ref="base.module_category_project_management"/>
        </record>

        <record id="group_kondro_dt_manager" model="res.groups">
            <field name="name">Kondro - Directeur Technique (Manager)</field>
            <field name="implied_ids" eval="[(4, ref('group_kondro_dt_user'))]"/>
            <field name="category_id" ref="base.module_category_project_management"/>
        </record>

        <record id="group_kondro_dt_admin" model="res.groups">
            <field name="name">Kondro - Directeur Technique (Administrateur)</field>
            <field name="implied_ids" eval="[(4, ref('group_kondro_dt_manager'))]"/>
            <field name="category_id" ref="base.module_category_project_management"/>
        </record>
    </data>
</odoo>
