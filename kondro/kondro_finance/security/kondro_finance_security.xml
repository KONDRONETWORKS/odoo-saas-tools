<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Groupes de sécurité -->
        <record id="group_kondro_finance_user" model="res.groups">
            <field name="name">KONDRO Finance / Utilisateur</field>
            <field name="category_id" ref="base.module_category_accounting"/>
        </record>
        
        <record id="group_kondro_finance_manager" model="res.groups">
            <field name="name">KONDRO Finance / Gestionnaire</field>
            <field name="category_id" ref="base.module_category_accounting"/>
            <field name="implied_ids" eval="[(4, ref('group_kondro_finance_user'))]"/>
        </record>
    </data>
</odoo>
