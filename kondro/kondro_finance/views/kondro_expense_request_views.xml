<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Vue Kanban des Dépenses -->
    <record id="view_kondro_expense_request_kanban" model="ir.ui.view">
        <field name="name">kondro.expense.request.kanban</field>
        <field name="model">kondro.expense.request</field>
        <field name="arch" type="xml">
            <kanban default_group_by="state" class="o_kanban_dashboard">
                <field name="id"/>
                <field name="name"/>
                <field name="expense_type"/>
                <field name="state"/>
                <field name="estimated_amount"/>
                <field name="paid_amount"/>
                <field name="department_id"/>
                <field name="project_id"/>
                <templates>
                    <t t-name="kanban-box">
                        <div class="oe_kanban_card oe_kanban_global_click">
                            <div class="o_kanban_card_header">
                                <div class="o_kanban_card_header_title">
                                    <div class="o_primary">
                                        <field name="name"/>
                                    </div>
                                    <div class="o_secondary">
                                        <field name="expense_type"/>
                                    </div>
                                </div>
                            </div>
                            <div class="o_kanban_card_content">
                                <div class="row">
                                    <div class="col-12">
                                        <strong>Montant:</strong> <field name="estimated_amount"/>
                                    </div>
                                </div>
                                <div class="row mt-2">
                                    <div class="col-6">
                                        <small>Payé: <field name="paid_amount"/></small>
                                    </div>
                                    <div class="col-6">
                                        <field name="project_id" invisible="expense_type != 'commercial'"/>
                                        <field name="department_id" invisible="expense_type != 'internal'"/>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- Vue Liste des Dépenses -->
    <record id="view_kondro_expense_request_tree" model="ir.ui.view">
        <field name="name">kondro.expense.request.tree</field>
        <field name="model">kondro.expense.request</field>
        <field name="arch" type="xml">
            <list string="Demandes de Dépense">
                <field name="name"/>
                <field name="expense_type"/>
                <field name="state"/>
                <field name="department_id"/>
                <field name="project_id"/>
                <field name="estimated_amount" sum="Total"/>
                <field name="paid_amount" sum="Total"/>
                <field name="planned_payment_date"/>
                <field name="payment_date"/>
            </list>
        </field>
    </record>

    <!-- Vue Formulaire des Dépenses -->
    <record id="view_kondro_expense_request_form" model="ir.ui.view">
        <field name="name">kondro.expense.request.form</field>
        <field name="model">kondro.expense.request</field>
        <field name="arch" type="xml">
            <form string="Demande de Dépense">
                <header>
                    <button name="action_submit" string="Soumettre" type="object" class="oe_highlight"/>
                    <button name="action_validate" string="Valider" type="object"/>
                    <button name="action_approve" string="Approuver" type="object"/>
                    <button name="action_plan" string="Planifier" type="object"/>
                    <button name="action_pay" string="Payer" type="object" class="oe_highlight"/>
                    <button name="action_close" string="Clôturer" type="object"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,submitted,validated,approved,planned,paid,closed"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_treasury_movements" type="object" class="oe_stat_button" icon="fa-money">
                            <field name="treasury_movement_count" widget="statinfo" string="Mouvements"/>
                        </button>
                    </div>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="expense_type"/>
                            <field name="department_id"/>
                            <field name="project_id"/>
                        </group>
                        <group>
                            <field name="estimated_amount"/>
                            <field name="paid_amount" readonly="1"/>
                            <field name="currency_id" invisible="1"/>
                            <field name="budget_line_id"/>
                        </group>
                    </group>
                    <group>
                        <group>
                            <field name="supplier_id" options="{'no_create': True}"/>
                            <field name="employee_id" options="{'no_create': True}"/>
                        </group>
                        <group>
                            <field name="planned_payment_date"/>
                            <field name="payment_account_id"/>
                            <field name="payment_method"/>
                            <field name="payment_date" readonly="1"/>
                        </group>
                    </group>
                    <group>
                        <field name="description" placeholder="Description de la dépense..."/>
                    </group>
                    <notebook>
                        <page string="Pièces Jointes">
                            <field name="attachment_ids" widget="many2many_binary"/>
                        </page>
                        <page string="Validation">
                            <group>
                                <group>
                                    <field name="validated_by_id" readonly="1"/>
                                    <field name="validated_date" readonly="1"/>
                                </group>
                                <group>
                                    <field name="approved_by_id" readonly="1"/>
                                    <field name="approved_date" readonly="1"/>
                                </group>
                            </group>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- Action pour les Dépenses -->
    <record id="action_kondro_expense_request" model="ir.actions.act_window">
        <field name="name">Demandes de Dépense</field>
        <field name="res_model">kondro.expense.request</field>
        <field name="view_mode">kanban,tree,form</field>
        <field name="context">{'search_default_group_by_state': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Créer une nouvelle demande de dépense
            </p>
        </field>
    </record>
</odoo>
