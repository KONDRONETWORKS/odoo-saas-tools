<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="action_kondro_dt_documents" model="ir.actions.act_window">
            <field name="name">Documents DT</field>
            <field name="res_model">kondro.dt.document</field>
            <field name="view_mode">kanban,tree,form</field>
            <field name="context">{"search_default_group_by_project": 0}</field>
        </record>

        <record id="action_kondro_dt_document_category" model="ir.actions.act_window">
            <field name="name">Catégories DT</field>
            <field name="res_model">kondro.dt.document.category</field>
            <field name="view_mode">tree,form</field>
        </record>

        <menuitem id="menu_kondro_dt_docs_root"
                  name="Bibliothèque"
                  parent="kondro_dt_hub.menu_kondro_dt_root"
                  groups="kondro_dt_hub.group_kondro_dt_user"
                  sequence="30"/>

        <menuitem id="menu_kondro_dt_docs"
                  name="Documents"
                  parent="menu_kondro_dt_docs_root"
                  action="action_kondro_dt_documents"
                  groups="kondro_dt_hub.group_kondro_dt_user"
                  sequence="5"/>

        <menuitem id="menu_kondro_dt_docs_category"
                  name="Catégories"
                  parent="menu_kondro_dt_docs_root"
                  action="action_kondro_dt_document_category"
                  groups="kondro_dt_hub.group_kondro_dt_manager"
                  sequence="10"/>
    </data>
</odoo>
