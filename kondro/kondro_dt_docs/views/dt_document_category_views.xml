<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="view_kondro_dt_document_category_tree" model="ir.ui.view">
            <field name="name">kondro.dt.document.category.tree</field>
            <field name="model">kondro.dt.document.category</field>
            <field name="arch" type="xml">
                <list string="Catégories de documents">
                    <field name="name"/>
                    <field name="sequence"/>
                    <field name="document_count" string="Documents"/>
                    <field name="active"/>
                </list>
            </field>
        </record>

        <record id="view_kondro_dt_document_category_form" model="ir.ui.view">
            <field name="name">kondro.dt.document.category.form</field>
            <field name="model">kondro.dt.document.category</field>
            <field name="arch" type="xml">
                <form string="Catégorie documentaire">
                    <sheet>
                        <div class="oe_button_box" name="button_box">
                            <button name="action_open_documents" type="object" class="oe_stat_button" icon="fa-folder-open">
                                <field name="document_count" widget="statinfo" string="Documents"/>
                            </button>
                        </div>
                        <group>
                            <group>
                                <field name="name"/>
                                <field name="sequence"/>
                                <field name="color" widget="colorpicker"/>
                            </group>
                            <group>
                                <field name="active"/>
                                <field name="description"/>
                            </group>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>
    </data>
</odoo>
