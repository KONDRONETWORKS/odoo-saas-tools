<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="view_kondro_project_form_dt_docs" model="ir.ui.view">
            <field name="name">kondro.project.form.dt.docs</field>
            <field name="model">kondro.project</field>
            <field name="inherit_id" ref="kondro_dt_projects.view_kondro_project_form_dt"/>
            <field name="arch" type="xml">
                <xpath expr="//div[@name='button_box']" position="inside">
                    <button name="action_open_dt_documents" type="object" class="oe_stat_button" icon="fa-folder" groups="kondro_dt_hub.group_kondro_dt_user">
                        <field name="dt_document_count" widget="statinfo" string="Docs"/>
                    </button>
                </xpath>
                <xpath expr="//page[@string='Technique']" position="after">
                    <page string="Docs DT" groups="kondro_dt_hub.group_kondro_dt_user">
                        <field name="dt_document_ids" context="{'default_project_id': active_id}" nolabel="1">
                            <tree editable="bottom">
                                <field name="reference" readonly="1"/>
                                <field name="name"/>
                                <field name="version"/>
                                <field name="category_id"/>
                                <field name="state" readonly="1"/>
                            </tree>
                        </field>
                    </page>
                </xpath>
            </field>
        </record>
    </data>
</odoo>
