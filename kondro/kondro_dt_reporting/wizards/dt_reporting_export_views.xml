<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="view_kondro_dt_reporting_export_wizard" model="ir.ui.view">
            <field name="name">kondro.dt.reporting.export.wizard.form</field>
            <field name="model">kondro.dt.reporting.export.wizard</field>
            <field name="arch" type="xml">
                <form string="Export KPIs">
                    <group>
                        <group>
                            <field name="date_from"/>
                            <field name="date_to"/>
                        </group>
                        <group>
                            <field name="config_ids" widget="many2many_tags" options="{'no_create': True}"/>
                            <field name="include_details" invisible="1"/>
                        </group>
                    </group>
                    <footer>
                        <button name="action_export" string="Exporter" type="object" class="btn-primary"/>
                        <button string="Annuler" special="cancel" class="btn-secondary"/>
                    </footer>
                </form>
            </field>
        </record>
    </data>
</odoo>
