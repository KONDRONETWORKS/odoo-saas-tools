<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="ir_actions_server_kondro_dt_reporting_daily" model="ir.actions.server">
            <field name="name">KPI DT - Calcul quotidien</field>
            <field name="model_id" ref="model_kondro_dt_report_config"/>
            <field name="state">code</field>
            <field name="code">model.cron_compute_snapshots()</field>
        </record>

        <record id="cron_kondro_dt_reporting_daily" model="ir.cron">
            <field name="ir_actions_server_id" ref="kondro_dt_reporting.ir_actions_server_kondro_dt_reporting_daily"/>
            <field name="user_id" ref="base.user_admin"/>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="nextcall" eval="(DateTime.now() + relativedelta(hours=1)).strftime('%Y-%m-%d %H:%M:%S')"/>
            <field name="active">True</field>
        </record>
    </data>
</odoo>
