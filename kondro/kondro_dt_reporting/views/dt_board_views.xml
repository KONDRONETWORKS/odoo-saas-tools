<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="view_kondro_dt_reporting_board_tree" model="ir.ui.view">
            <field name="name">kondro.dt.reporting.board.tree</field>
            <field name="model">kondro.dt.reporting.board</field>
            <field name="arch" type="xml">
                <tree string="Tableaux DT">
                    <field name="name"/>
                    <field name="owner_id"/>
                    <field name="snapshot_count"/>
                    <field name="active"/>
                </tree>
            </field>
        </record>

        <record id="view_kondro_dt_reporting_board_form" model="ir.ui.view">
            <field name="name">kondro.dt.reporting.board.form</field>
            <field name="model">kondro.dt.reporting.board</field>
            <field name="arch" type="xml">
                <form string="Tableau de bord DT">
                    <header>
                        <button name="action_refresh_snapshots" type="object" string="Actualiser" class="oe_highlight"/>
                        <field name="active"/>
                    </header>
                    <sheet>
                        <div class="oe_button_box" name="button_box">
                            <button type="object" name="action_refresh_snapshots" class="oe_stat_button" icon="fa-refresh">
                                <field name="snapshot_count" widget="statinfo" string="Relevés"/>
                            </button>
                        </div>
                        <group>
                            <group>
                                <field name="name"/>
                                <field name="sequence"/>
                                <field name="owner_id"/>
                            </group>
                            <group>
                                <field name="currency_id"/>
                                <field name="description"/>
                            </group>
                        </group>
                        <notebook>
                            <page string="KPIs">
                                <field name="config_ids" widget="many2many_tags"/>
                            </page>
                            <page string="Relevés">
                                <field name="snapshot_ids" nolabel="1">
                                    <tree>
                                        <field name="period_end"/>
                                        <field name="name"/>
                                        <field name="value"/>
                                        <field name="delta_value" optional="show"/>
                                        <field name="delta_percent" optional="show"/>
                                    </tree>
                                </field>
                            </page>
                        </notebook>
                    </sheet>
                    <chatter/>
                </form>
            </field>
        </record>
    </data>
</odoo>
