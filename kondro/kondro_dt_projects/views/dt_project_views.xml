<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Boutons statistiques supplémentaires -->
        <record id="view_kondro_project_form_dt" model="ir.ui.view">
            <field name="name">kondro.project.form.dt</field>
            <field name="model">kondro.project</field>
            <field name="inherit_id" ref="kondro_core.view_kondro_project_form"/>
            <field name="arch" type="xml">
                <xpath expr="//div[@name='button_box']" position="inside">
                    <button name="action_view_dt_milestones" type="object" class="oe_stat_button" icon="fa-flag-checkered" groups="kondro_dt_hub.group_kondro_dt_user">
                        <field name="milestone_count" widget="statinfo" string="Jalons"/>
                    </button>
                    <button name="action_view_dt_risks" type="object" class="oe_stat_button" icon="fa-exclamation-triangle" groups="kondro_dt_hub.group_kondro_dt_manager">
                        <field name="risk_count" widget="statinfo" string="Risques"/>
                    </button>
                    <button name="action_view_dt_designs" type="object" class="oe_stat_button" icon="fa-cogs" groups="kondro_dt_hub.group_kondro_dt_user">
                        <field name="design_count" widget="statinfo" string="Documents"/>
                    </button>
                </xpath>
                <xpath expr="//header" position="inside">
                    <field name="technical_stage" widget="statusbar" statusbar_visible="definition,design,implementation,validation,handover" groups="kondro_dt_hub.group_kondro_dt_user"/>
                </xpath>
                <xpath expr="//notebook" position="inside">
                    <page name="dt_technique_page" string="Technique" groups="kondro_dt_hub.group_kondro_dt_user">
                        <group>
                            <group>
                                <field name="deadline_date"/>
                                <field name="technical_summary" placeholder="Résumé des décisions techniques..."/>
                            </group>
                            <group col="1">
                                <field name="milestone_ids" context="{'default_project_id': id}" nolabel="1">
                                    <list editable="bottom">
                                        <field name="name"/>
                                        <field name="state"/>
                                        <field name="target_date"/>
                                        <field name="owner_id"/>
                                        <field name="blocking"/>
                                    </list>
                                </field>
                            </group>
                        </group>
                    </page>
                </xpath>
            </field>
        </record>

        <!-- Ajout des champs à la vue liste -->
        <record id="view_kondro_project_tree_dt" model="ir.ui.view">
            <field name="name">kondro.project.tree.dt</field>
            <field name="model">kondro.project</field>
            <field name="inherit_id" ref="kondro_core.view_kondro_project_tree"/>
            <field name="arch" type="xml">
                <xpath expr="//list" position="inside">
                    <field name="technical_stage"/>
                    <field name="deadline_date"/>
                </xpath>
            </field>
        </record>
    </data>
</odoo>
