<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="view_kondro_dt_project_risk_tree" model="ir.ui.view">
            <field name="name">kondro.dt.project.risk.tree</field>
            <field name="model">kondro.dt.project.risk</field>
            <field name="arch" type="xml">
                <tree string="Risques techniques" decoration-danger="risk_level == 'escalate'" decoration-warning="risk_level == 'mitigate'">
                    <field name="name"/>
                    <field name="project_id" optional="hide"/>
                    <field name="category"/>
                    <field name="probability"/>
                    <field name="impact"/>
                    <field name="risk_level"/>
                    <field name="status"/>
                    <field name="owner_id" optional="show"/>
                    <field name="next_review_date"/>
                </tree>
            </field>
        </record>

        <record id="view_kondro_dt_project_risk_form" model="ir.ui.view">
            <field name="name">kondro.dt.project.risk.form</field>
            <field name="model">kondro.dt.project.risk</field>
            <field name="arch" type="xml">
                <form string="Risque technique">
                    <sheet>
                        <group>
                            <group>
                                <field name="name"/>
                                <field name="project_id"/>
                                <field name="category"/>
                                <field name="status"/>
                                <field name="owner_id"/>
                            </group>
                            <group>
                                <field name="probability"/>
                                <field name="impact"/>
                                <field name="risk_level" readonly="1"/>
                                <field name="next_review_date"/>
                            </group>
                        </group>
                        <group>
                            <field name="mitigation_plan" colspan="2" placeholder="Plan d’atténuation..."/>
                        </group>
                    </sheet>
                    <chatter/>
                </form>
            </field>
        </record>

        <record id="action_kondro_dt_project_risk" model="ir.actions.act_window">
            <field name="name">Risques techniques</field>
            <field name="res_model">kondro.dt.project.risk</field>
            <field name="view_mode">tree,form</field>
            <field name="context">{"search_default_category": 'technical'}</field>
        </record>
    </data>
</odoo>
