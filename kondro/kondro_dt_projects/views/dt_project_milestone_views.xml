<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="view_kondro_dt_project_milestone_tree" model="ir.ui.view">
            <field name="name">kondro.dt.project.milestone.tree</field>
            <field name="model">kondro.dt.project.milestone</field>
            <field name="arch" type="xml">
                <tree string="Jalons techniques">
                    <field name="name"/>
                    <field name="project_id" optional="hide"/>
                    <field name="state"/>
                    <field name="target_date"/>
                    <field name="completion_date" optional="show"/>
                    <field name="owner_id"/>
                    <field name="blocking" invisible="1"/>
                    <field name="progress" optional="show"/>
                </tree>
            </field>
        </record>

        <record id="view_kondro_dt_project_milestone_form" model="ir.ui.view">
            <field name="name">kondro.dt.project.milestone.form</field>
            <field name="model">kondro.dt.project.milestone</field>
            <field name="arch" type="xml">
                <form string="Jalon technique">
                    <sheet>
                        <group>
                            <group>
                                <field name="name"/>
                                <field name="project_id"/>
                                <field name="state" widget="statusbar" statusbar_visible="draft,planned,in_progress,done"/>
                                <field name="owner_id"/>
                            </group>
                            <group>
                                <field name="target_date"/>
                                <field name="completion_date"/>
                                <field name="blocking"/>
                                <field name="progress" widget="progressbar"/>
                            </group>
                        </group>
                        <group>
                            <field name="description" colspan="2" placeholder="Détails du jalon..."/>
                        </group>
                    </sheet>
                    <chatter/>
                </form>
            </field>
        </record>

        <record id="action_kondro_dt_project_milestone" model="ir.actions.act_window">
            <field name="name">Jalons techniques</field>
            <field name="res_model">kondro.dt.project.milestone</field>
            <field name="view_mode">tree,form</field>
            <field name="context">{"search_default_group_by_state": 1}</field>
        </record>
    </data>
</odoo>
