<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_company_kondronetworks_form" model="ir.ui.view">
        <field name="name">res.company.form.kondronetworks</field>
        <field name="model">res.company</field>
        <field name="inherit_id" ref="base.view_company_form"/>
        <field name="arch" type="xml">
            <field name="name" position="after">
                <field name="country_id" readonly="1" attrs="{'invisible': [('name', '!=', 'KONDRONETWORKS')]}"/>
            </field>
        </field>
    </record>
</odoo>
