            <div class="o-mail-Message position-relative rounded-0" t-att-data-persistent="message.persistent" t-att-data-starred="message.starred" t-att-class="attClass" role="group" t-att-aria-label="messageTypeText" t-on-click="onClick" t-on-mouseenter="onMouseenter" t-on-mouseleave="onMouseleave" t-ref="root" t-if="message.exists()">
