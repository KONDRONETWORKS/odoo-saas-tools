        return {
            preview: (...args) => {
                revertOperation();
                revertOperation = this.makeSavePoint();
                operation(...args);
            },
            commit: (...args) => {
                revertOperation();
                operation(...args);
                this.addStep();
            },
            revert: () => {
                revertOperation();
            },
