<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_inherited_backup_ftp" model="ir.ui.view">
            <field name="name">res.config.settings.view.form.inherit.backup_ftp</field>
            <field name="model">res.config.settings</field>
            <field name="priority" eval="20" />
            <field name="inherit_id" ref="base.res_config_settings_view_form" />
            <field name="arch" type="xml">
            <xpath expr="//div[@data-key='saas_server']" position="inside">
                <h3>SFTP Backup Settings</h3>
                <div class="row mt16 o_settings_container">
                    <div class="col-12 col-lg-12 o_setting_box">
                        <div class="o_setting_left_pane"/>
                        <div class="o_setting_right_pane">
                            <label for="sftp_server" string="SFTP Server Address"/>
                            <div class="text-muted mb-2">IP address of your remote server. For example 192.168.0.1</div>
                            <div class="content-group mt16">
                                <field name="sftp_server" placeholder="192.168.0.1"/>
                            </div>
                        </div>
                    </div>
                    <div class="col-12 col-lg-12 o_setting_box">
                        <div class="o_setting_left_pane"/>
                        <div class="o_setting_right_pane">
                            <label for="sftp_username" string="Username on SFTP Server"/>
                            <div class="text-muted mb-2">The username where the SFTP connection should be made with. This is the user on the external server.</div>
                            <div class="content-group mt16">
                                <field name="sftp_username" placeholder="username"/>
                            </div>
                        </div>
                    </div>
                    <div class="col-12 col-lg-12 o_setting_box">
                        <div class="o_setting_left_pane"/>
                        <div class="o_setting_right_pane">
                            <label for="sftp_password" string="Password User SFTP Server"/>
                            <div class="text-muted mb-2">The password from the user where the SFTP connection should be made with. This is the password from the user on the external server.</div>
                            <div class="content-group mt16">
                                <field name="sftp_password" password="True"/>
                            </div>
                        </div>
                    </div>
                    <div class="col-12 col-lg-12 o_setting_box">
                        <div class="o_setting_left_pane"/>
                        <div class="o_setting_right_pane">
                            <label for="sftp_path" string="Path external server"/>
                            <div class="text-muted mb-2">The location to the folder where the dumps should be written to. For example /odoo/backups/.<br />Files will then be written to /odoo/backups/ on your remote server.</div>
                            <div class="content-group mt16">
                                <field name="sftp_path" placeholder="/odoo/backups/"/>
                            </div>
                        </div>
                    </div>
                    <div class="col-12 col-lg-12 o_setting_box">
                        <div class="o_setting_left_pane"/>
                        <div class="o_setting_right_pane">
                            <label for="sftp_public_key" string="SFTP-Server public key"/>
                            <div class="text-muted mb-2">SFTP-Server public key</div>
                            <div class="content-group mt16">
                                <field name="sftp_public_key"/>
                            </div>
                        </div>
                    </div>
                    <div class="col-12 col-lg-12 o_setting_box">
                        <div class="o_setting_left_pane"/>
                        <div class="o_setting_right_pane">
                            <label for="rsa_key_path" string="Path to RSA key on Odoo server"/>
                            <div class="text-muted mb-2">The location of the folder with rsa key on Odoo server.</div>
                            <div class="content-group mt16">
                                <field name="rsa_key_path" placeholder="/opt/odoo/.ssh/id_rsa"/>
                            </div>
                        </div>
                    </div>
                    <div class="col-12 col-lg-12 o_setting_box">
                        <div class="o_setting_left_pane"/>
                        <div class="o_setting_right_pane">
                            <label for="rsa_key_passphrase" string="Passphrase for RSA key"/>
                            <div class="text-muted mb-2">Passphrase for RSA key</div>
                            <div class="content-group mt16">
                                <field name="rsa_key_passphrase" password="True"/>
                            </div>
                        </div>
                    </div>
                    <div class="col-12 col-lg-12 o_setting_box">
                        <div class="o_setting_left_pane"/>
                        <div class="o_setting_right_pane">
                            <div class="content-group">
                                <div class="row mt16">
                                    <button name="test_sftp_connection" type="object" string="Test SFTP Connection" class="btn btn-primary"/>
                                </div>
                            </div>
                            <div class="text-muted mt-3">
                                This configures the sftp server for store backups of client databases.<br />
                                Automatic backups of the database can be scheduled as follows:
                                <ol>
                                    <li>Go to Settings / Technical / Automation / Scheduled Actions.</li>
                                    <li>Search the action named 'Backup saas databases scheduler'.</li>
                                    <li>Set the scheduler to active and fill in how often you want backups generated.</li>
                                </ol>
                            </div>
                        </div>
                    </div>
                </div>
            </xpath>
            </field>
        </record>
</odoo>
