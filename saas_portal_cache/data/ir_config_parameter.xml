<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Configuration Redis par défaut -->
    <record id="ir_config_parameter_redis_host" model="ir.config_parameter">
        <field name="key">saas_portal_cache.redis_host</field>
        <field name="value">localhost</field>
    </record>
    
    <record id="ir_config_parameter_redis_port" model="ir.config_parameter">
        <field name="key">saas_portal_cache.redis_port</field>
        <field name="value">6379</field>
    </record>
    
    <record id="ir_config_parameter_redis_db" model="ir.config_parameter">
        <field name="key">saas_portal_cache.redis_db</field>
        <field name="value">0</field>
    </record>
    
    <record id="ir_config_parameter_cache_enabled" model="ir.config_parameter">
        <field name="key">saas_portal_cache.enabled</field>
        <field name="value">True</field>
    </record>
    
    <record id="ir_config_parameter_cache_default_ttl" model="ir.config_parameter">
        <field name="key">saas_portal_cache.default_ttl</field>
        <field name="value">300</field>
    </record>
</odoo>
