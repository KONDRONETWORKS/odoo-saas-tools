scripts/legacy/
tests/legacy/
docs/temp/

# Fichiers de configuration personnels
odoo.conf.local
odoo.conf.*.local

# Fichiers de test temporaires
test_*.py
*_test.py
!**/tests/**/*_test.py

# Fichiers de solution temporaires
SOLUTION_*.md
TEST_*.md

# Python
