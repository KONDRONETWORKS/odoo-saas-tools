[options]
# Configuration de production Odoo SaaS Tools

# Base de données
admin_passwd = $pbkdf2-sha512$600000$ak1JSQmBsNZ6L6W0Vuqd8w$RYGvT0vfH0JUng2NSDLd9DL4m2BtTJMYDKddJxORNDR1JePjUGRjbepoXlJPxtOL2A34XumJuqgdnacZdGd2cg
db_host = localhost
db_port = 5432
db_user = odoo
db_password = odoo_password_secure
db_name = odoo

# Chemins
addons_path = /opt/odoo-saas-tools,/opt/odoo/addons
data_dir = /opt/odoo-saas-tools/filestore

# Réseau
xmlrpc_port = 8069
longpolling_port = 8072
workers = 4
max_cron_threads = 2

# Performance
limit_memory_hard = 2684354560
limit_memory_soft = 2147483648
limit_request = 8192
limit_time_cpu = 600
limit_time_real = 1200

# Logs
log_level = info
log_handler = :INFO
logfile = /var/log/odoo/odoo.log

# Sécurité
proxy_mode = True
without_demo = True

# SaaS spécifique
saas_portal_domain = saas.votre-domaine.com
saas_server_domain = server.votre-domaine.com
