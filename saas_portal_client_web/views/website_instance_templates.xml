<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Template temporairement désactivé - web.assets_frontend n'existe pas dans Odoo 18 -->
    <!-- 
    <template id="assets_frontend_v18" inherit_id="web.assets_frontend"
        name="saas portal portal assets">
        <xpath expr="." position="inside">
            <script type="text/javascript" src="/saas_portal_client_web/static/src/js/main.js" />
        </xpath>
    </template>
    -->
    <template id="portal_my_home_saas" name="Portal My Home : saas instances"
        inherit_id="portal.portal_my_home" priority="20">
        <xpath expr="//div[contains(@class,'o_portal_my_home')]" position="inside">
            <h3 class="page-header" t-if="instance_count">
                <a href="/my/instances">Your Instances
                    <small class="ml-2">
                        <span class="badge">
                            <t t-esc="instance_count" />
                        </span>
                    </small>
                </a>
            </h3>
        </xpath>
    </template>
    <template id="portal_instances" name="Instances">
        <t t-call="portal.portal_layout">
            <h3>Instances<t t-call="portal.portal_searchbar" />
            </h3>
        </t>
    </template>
    <template id="portal_my_instances" name="My Instances">
        <t t-call="portal.portal_layout">
            <h3>Instances<t t-call="portal.portal_searchbar" />
            </h3>
            <t t-if="not instances">
                <p>There are currently no instances for your account.</p>
            </t>
            <div t-if="instances" class="panel panel-default">
                <div class="table-responsive">
                    <table class="table table-hover o_portal_my_doc_table">
                        <thead>
                            <tr class="active">
                                <th>Name</th>
                                <th>Plan</th>
                                <th>Valid Until</th>
                                <th />
                            </tr>
                        </thead>
                        <t t-foreach="instances" t-as="instance">
                            <tr>
                                <td>
                                    <a t-attf-href="/my/domain/#{instance.id}?#{keep_query()}">
                                        <t t-esc="instance.name" />
                                    </a>
                                </td>
                                <td>
                                    <span t-field="instance.plan_id.name" />
                                </td>
                                <td>
                                    <span t-field="instance.expiration_datetime" />
                                </td>
                                <td>
                                    <t t-if="instance.expired">
                                        <span class="label label-default">
                                            <i class="fa fa-fw fa-clock-o" /> Expired</span>
                                    </t>
                                </td>
                            </tr>
                        </t>
                    </table>
                </div>
                <div t-if="pager" class="o_portal_pager text-center">
                    <t t-call="portal.pager" />
                </div>
            </div>
        </t>
    </template>
    <template id="change_domain">
        <t t-call="website.layout">
            <t t-set="additional_title">Domain name</t>
            <div id="wrap">
                <div class="container">
                    <h1>
                        <t t-esc="saas_portal_client.name" />
                    </h1>
                    <form role="form" class="form-inline">
                        <input type="hidden" name="client_id" t-att-value="saas_portal_client.id" />
                        <input type="hidden" name="base_saas_domain" t-att-value="base_saas_domain" />
                        <div class="input-group">
                            <input data-placement="bottom" name="new_domain_name"
                                data-trigger="manual" type="text" placeholder="your-new-domain-name"
                                class="form-control new_domain_name" data-original-title="" title="" />
                        </div>
                        <div style="margin-top:30px;">
                            <p>To work with the new domain you should do the following:</p>
                            <ul>
                                <li>Look up for IP address of our server as such: <p>$ ping <t
                                            t-esc="saas_portal_client.server_id.name" />
                                    </p>
                                </li>
                                <li> Map your new name to the IP address on your DNS server. Use the
                                    A record for that.</li>
                            </ul>
                            <p>Warning:</p>
                            <p>Be sure that the new domain name is point to our server before you
                                apply</p>
                            <button type="submit" id="change_domain" class="btn btn-info">
                                <strong>Apply</strong>
                                <span class="hidden-xs" />
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </t>
    </template>
</odoo>